{
  "permissions": {
    "allow": [
      "Bash(npx vitest *)",
      "Bash(npx eslint *)",
      "Bash(npx shadcn *)",
      "Bash(npm run church*)",
      "Bash(npm run import:source*)",
      "Bash(npm run issues*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)"
    ],
    "ask": [
      "WebFetch(domain:hapshin.org)",
      "WebFetch(domain:kcm.kr)",
      "WebFetch(domain:ch114.kr)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Edit(./.env.local)",
      "Edit(./data/raw/**)",
      "Edit(./src/components/ui/**)",
      "Bash(rm -rf *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/check-sensitive.mts"
          }
        ]
      }
    ]
  }
}
