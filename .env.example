# 사이트 절대 URL — metadata canonical, sitemap.xml, OG 이미지 경로 생성에 사용한다.
# 로컬은 http://localhost:3000, Vercel은 실제 도메인.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 사용자 제보를 GitHub Issues로 등록할 때 쓰는 토큰 (issues:write 권한). [미구현]
# 서버 전용이므로 NEXT_PUBLIC_ 접두사를 붙이지 않는다.
GITHUB_TOKEN=
GITHUB_REPO=jeoniltae/reformed-church-directory
