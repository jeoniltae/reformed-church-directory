# 사이트 절대 URL — metadata canonical, sitemap.xml, OG 이미지 경로 생성에 사용한다.
# 로컬은 http://localhost:3000, Vercel은 https://www.refchurch.kr.
#
# **정본은 www다.** apex(refchurch.kr)는 Vercel이 308로 www에 넘긴다. 여기에 apex를
# 넣으면 canonical이 "리다이렉트되는 주소"를 가리키게 되므로 www를 반드시 포함한다.
# Vercel 환경변수 스코프는 Production + Preview, 타입은 Config다(Secret 아님 — 공개 값이다).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 사용자 제보를 GitHub Issues로 등록할 때 쓰는 토큰 (issues:write 권한).
# 서버 전용이므로 NEXT_PUBLIC_ 접두사를 붙이지 않는다.
GITHUB_TOKEN=
GITHUB_REPO=jeoniltae/reformed-church-directory

# 도로명주소 OpenAPI 승인키 (business.juso.go.kr).
# 앱 런타임이 아니라 scripts/의 오프라인 배치에서만 쓴다.
# API별로 승인키가 따로 발급되므로 두 개를 분리해 둔다.
#   JUSO_SEARCH_KEY — 도로명주소 검색 API. 주소 정규화 + 코드 5개 획득
#   JUSO_COORD_KEY  — 좌표제공 검색 API. 위 코드로 entX/entY 획득
# 절대 NEXT_PUBLIC_ 접두사를 붙이지 않는다 — 붙이면 클라이언트 번들에 노출된다.
JUSO_SEARCH_KEY=
JUSO_COORD_KEY=

# Kakao 지도 JS SDK의 JavaScript 키.
#
# **여기만 NEXT_PUBLIC_이 붙는 이유** — 위 JUSO 키와 성격이 정반대다. 저쪽은 서버가
# 부르는 값이라 숨겨야 하지만, 지도 SDK는 **브라우저가 직접 부르므로 노출이 전제**다.
# 소스 보기로 누구나 볼 수 있고, 그래도 되도록 카카오가 **등록된 도메인에서만** 동작하게
# 막는다 — 즉 이 키의 보안 경계는 키 자체가 아니라 **콘솔에 등록한 도메인 목록**이다.
#
# ⚠️ **다른 앱에서 가져온 공유 키다 (2026-09-19).** 카카오맵 무료 일간 쿼터는
# **계정당 첫 활성화 앱 하나**에만 주어지는데 그 자리를 이미 다른 앱이 쓰고 있다.
# 새 앱을 켜면 월렛(결제 수단) 연결이 필요해 유료가 되므로, 기존 앱의 키를 쓰고
# 그 앱의 플랫폼에 이 사이트 도메인만 추가 등록했다. **두 서비스가 쿼터를 공유하고,
# 그 앱을 지우면 이쪽 지도도 죽는다.** 경위는 docs/지도-작업.md 0단계.
NEXT_PUBLIC_KAKAO_MAP_KEY=
