# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# editors
.vscode/
.idea/

# claude code (머신별 권한 설정)
.claude/settings.local.json

# windows
Thumbs.db
ehthumbs.db
Desktop.ini

# 크롤러가 내려받은 원본 (KML 등) — 가공 결과인 data/churches.json은 커밋한다
/data/raw/

# 진단 스크립트의 중간 산출물 — 사람이 확인용으로 보는 작업 파일
/data/reports/

# docs — coding-guidelines.md만 공유하고 나머지(작업 노트·체크리스트·계획)는 로컬에 둔다
/docs/*
!/docs/coding-guidelines.md
